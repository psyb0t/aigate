{
  "models": {
    "nomic-embed-v2": {
      "repo": "nomic-ai/nomic-embed-text-v2-moe",
      "vllm_args": [
        "--runner", "pooling",
        "--trust-remote-code",
        "--gpu-memory-utilization", "0.40",
        "--max-model-len", "512"
      ],
      "endpoints": ["embeddings"]
    },
    "qwen3-0.6b": {
      "repo": "Qwen/Qwen3-0.6B",
      "vllm_args": [
        "--enforce-eager",
        "--gpu-memory-utilization", "0.45",
        "--max-model-len", "16384"
      ],
      "endpoints": ["chat", "completions"]
    }
  }
}
