{
  "models": {
    "bge-m3": {
      "repo": "BAAI/bge-m3",
      "vllm_args": [
        "--runner", "pooling",
        "--enforce-eager",
        "--max-model-len", "8192"
      ],
      "endpoints": ["embeddings"]
    },
    "nomic-embed-v1.5": {
      "repo": "nomic-ai/nomic-embed-text-v1.5",
      "vllm_args": [
        "--runner", "pooling",
        "--trust-remote-code",
        "--enforce-eager",
        "--max-model-len", "2048"
      ],
      "endpoints": ["embeddings"]
    },
    "qwen3-0.6b": {
      "repo": "Qwen/Qwen3-0.6B",
      "vllm_args": [
        "--enforce-eager",
        "--max-model-len", "8192"
      ],
      "endpoints": ["chat", "completions"]
    }
  }
}
